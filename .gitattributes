# Normaliza fim de linha: evita que Windows e outros sistemas briguem por \r\n
* text=auto eol=lf

# Arquivos binários: o git não tenta mesclar nem mexer no conteúdo
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.blend binary
*.aseprite binary
*.psd binary
*.res binary
*.scn binary
